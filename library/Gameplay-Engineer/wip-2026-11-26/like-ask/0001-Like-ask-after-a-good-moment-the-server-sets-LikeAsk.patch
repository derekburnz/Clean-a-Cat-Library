diff --git a/games/clean-a-cat/src/client/Controllers/LikeAskController.luau b/games/clean-a-cat/src/client/Controllers/LikeAskController.luau
new file mode 100644
index 0000000..6149834
--- /dev/null
+++ b/games/clean-a-cat/src/client/Controllers/LikeAskController.luau
@@ -0,0 +1,99 @@
+--!strict
+-- LikeAskController: the like ask on the client (LikeAskRules, switch likeAsk with askQueue). The server decides when
+-- it is due (the Player attribute LikeAskDue, the moment's name); this puts "like" in the ask queue, so it shows only
+-- when the screen is free, and sends the answer back. Design's card plugs in:
+--
+--   LikeAskController.onShow(show, hide?)   show(moment) puts the card up when its turn comes; hide() takes it down
+--   LikeAskController.answer(kind)          "yes" (Like the game: the card then opens the gift card's like row),
+--                                           "no" (Not now: not asked again for three visits) or "closed" (X or back)
+--
+-- Until a card is plugged in nothing is queued, so the switch shows nothing.
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local LikeAskRules = require(Shared:WaitForChild("LikeAskRules"))
+local LiveFlags = require(Shared:WaitForChild("LiveFlags"))
+local Remotes = require(Shared:WaitForChild("Remotes"))
+
+local ID = "like"
+
+local LikeAskController = {}
+
+local player = Players.LocalPlayer
+local ask: any = nil -- AskController
+local showCard: ((moment: string) -> ())? = nil
+local hideCard: (() -> ())? = nil
+local up = false
+
+local function due(): string?
+	local moment = player:GetAttribute(LikeAskRules.ATTRIBUTE)
+	return if type(moment) == "string" then moment else nil
+end
+
+local function sync()
+	local moment = due()
+	if
+		moment == nil
+		or not LiveFlags.isOn(LikeAskRules.FLAG)
+		or showCard == nil
+		or not ask.on()
+	then
+		ask.drop(ID)
+		if up then
+			up = false
+			if hideCard then
+				hideCard()
+			end
+			ask.done(ID, "closed")
+		end
+		return
+	end
+	if up then
+		return
+	end
+	ask.want(ID, function()
+		local now = due()
+		local show = showCard
+		if now == nil or show == nil then
+			ask.skip(ID) -- it went away while it waited
+			return
+		end
+		up = true
+		show(now)
+	end, function()
+		up = false
+		if hideCard then
+			hideCard()
+		end
+	end)
+end
+
+function LikeAskController.onShow(show: (moment: string) -> (), hide: (() -> ())?)
+	showCard = show
+	hideCard = hide
+	sync()
+end
+
+function LikeAskController.answer(kind: string)
+	local answer = LikeAskRules.cleanAnswer(kind)
+	if answer == nil or due() == nil then
+		return
+	end
+	Remotes.event("RequestLikeAnswer"):FireServer(answer)
+	up = false
+	ask.done(ID, answer)
+end
+
+function LikeAskController.Init(controllers: { [string]: any })
+	ask = controllers.AskController
+end
+
+function LikeAskController.Start()
+	player:GetAttributeChangedSignal(LikeAskRules.ATTRIBUTE):Connect(sync)
+	ReplicatedStorage:GetAttributeChangedSignal(LiveFlags.ATTRIBUTE_PREFIX .. LikeAskRules.FLAG)
+		:Connect(sync)
+	sync()
+end
+
+return LikeAskController
diff --git a/games/clean-a-cat/src/server/Services/LikeAskService.luau b/games/clean-a-cat/src/server/Services/LikeAskService.luau
new file mode 100644
index 0000000..e05fe58
--- /dev/null
+++ b/games/clean-a-cat/src/server/Services/LikeAskService.luau
@@ -0,0 +1,157 @@
+--!strict
+-- LikeAskService: decides when a player is asked to like the game (LikeAskRules, Derek's q2-likeask rule), behind the
+-- LiveFlags switch likeAsk with askQueue. Other services report moments:
+--   LikeAskService.moment(player, kind)   a good moment ("special", "crate", "stars", "helper", "purchase")
+--   LikeAskService.bad(player)            a lost cat or a cancelled purchase: no ask for two minutes
+-- When the ask is due the Player attribute LikeAskDue holds the moment's name; the client's ask queue shows Design's
+-- card when the screen is free and answers with RequestLikeAnswer. A "no" is saved (likeNoVisit), so the ask waits
+-- three visits; "closed" is no answer. Nothing here pays anything: the like row's coins stay FreeRewardService's.
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local AskRules = require(Shared:WaitForChild("AskRules"))
+local LikeAskRules = require(Shared:WaitForChild("LikeAskRules"))
+local LiveFlags = require(Shared:WaitForChild("LiveFlags"))
+
+local DataService = require(script.Parent:WaitForChild("DataService"))
+local NetService = require(script.Parent:WaitForChild("NetService"))
+local Telemetry = require(script.Parent:WaitForChild("Telemetry"))
+
+local CHECK_SECONDS = 1
+
+local LikeAskService = {}
+
+type Visit = {
+	asked: boolean, -- the ask came due this visit
+	lastBadAt: number,
+	pending: { moment: LikeAskRules.Moment, at: number }?, -- a purchase's ask, waiting PURCHASE_DELAY
+}
+
+local visits: { [Player]: Visit } = {}
+
+local function on(): boolean
+	return LiveFlags.isOn(LikeAskRules.FLAG) and LiveFlags.isOn(AskRules.FLAG)
+end
+
+local function visitOf(player: Player): Visit
+	local found = visits[player]
+	if found then
+		return found
+	end
+	local visit: Visit = { asked = false, lastBadAt = -math.huge, pending = nil :: any }
+	visits[player] = visit
+	return visit
+end
+
+local function blocked(player: Player, visit: Visit): boolean
+	local save = DataService.get(player)
+	if save == nil then
+		return true
+	end
+	return LikeAskRules.blocked({
+		visit = save.visits,
+		noVisit = save.likeNoVisit,
+		likePaid = save.freeRewards.like,
+		askedThisVisit = visit.asked,
+		lastBadAt = visit.lastBadAt,
+		now = os.clock(),
+	})
+end
+
+local function makeDue(player: Player, moment: LikeAskRules.Moment)
+	local visit = visitOf(player)
+	visit.asked = true
+	visit.pending = nil
+	player:SetAttribute(LikeAskRules.ATTRIBUTE, moment)
+	Telemetry.event(player, "like_ask_due", 1, { moment :: string })
+end
+
+function LikeAskService.moment(player: Player, kind: LikeAskRules.Moment)
+	if not on() or player.Parent ~= Players then
+		return
+	end
+	local visit = visitOf(player)
+	if blocked(player, visit) or player:GetAttribute(LikeAskRules.ATTRIBUTE) ~= nil then
+		return
+	end
+	local now = os.clock()
+	local at = LikeAskRules.dueAt(kind, now)
+	if at == nil then
+		return
+	elseif at <= now then
+		makeDue(player, kind)
+	elseif visit.pending == nil then
+		visit.pending = { moment = kind, at = at }
+	end
+end
+
+function LikeAskService.bad(player: Player)
+	local visit = visitOf(player)
+	visit.lastBadAt = os.clock()
+	visit.pending = nil -- a purchase's ask is dropped, not put off
+	-- an ask due but not answered yet goes away too; a later good moment may still bring it this visit
+	if player:GetAttribute(LikeAskRules.ATTRIBUTE) ~= nil then
+		player:SetAttribute(LikeAskRules.ATTRIBUTE, nil)
+		visit.asked = false
+	end
+end
+
+local function onAnswer(player: Player, raw: unknown)
+	local answer = LikeAskRules.cleanAnswer(raw)
+	local due = player:GetAttribute(LikeAskRules.ATTRIBUTE)
+	if answer == nil or due == nil then
+		return
+	end
+	player:SetAttribute(LikeAskRules.ATTRIBUTE, nil)
+	local save = DataService.get(player)
+	if answer == "no" and save then
+		save.likeNoVisit = save.visits
+	end
+	Telemetry.event(player, "like_ask_answered", 1, { answer :: string, tostring(due) })
+end
+
+function LikeAskService.Init(_services: { [string]: any }) end
+
+function LikeAskService.Start()
+	NetService.on("RequestLikeAnswer", { perSecond = 1, burst = 2 }, onAnswer)
+	Players.PlayerRemoving:Connect(function(player: Player)
+		visits[player] = nil
+	end)
+	for _, flag in { LikeAskRules.FLAG, AskRules.FLAG } do
+		ReplicatedStorage:GetAttributeChangedSignal(LiveFlags.ATTRIBUTE_PREFIX .. flag)
+			:Connect(function()
+				if on() then
+					return
+				end
+				for _, player in Players:GetPlayers() do
+					player:SetAttribute(LikeAskRules.ATTRIBUTE, nil)
+					local visit = visits[player]
+					if visit then
+						visit.pending = nil
+					end
+				end
+			end)
+	end
+	task.spawn(function()
+		while true do
+			task.wait(CHECK_SECONDS)
+			local now = os.clock()
+			for player, visit in visits do
+				local pending = visit.pending
+				if pending and now >= pending.at then
+					visit.pending = nil
+					if
+						on()
+						and not blocked(player, visit)
+						and player:GetAttribute(LikeAskRules.ATTRIBUTE) == nil
+					then
+						makeDue(player, pending.moment)
+					end
+				end
+			end
+		end
+	end)
+end
+
+return LikeAskService
