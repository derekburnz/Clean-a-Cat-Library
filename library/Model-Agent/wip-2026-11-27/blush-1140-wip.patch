diff --git a/assets/clean-a-cat/blender/hud_icons.py b/assets/clean-a-cat/blender/hud_icons.py
index 8df8d908..8422f654 100644
--- a/assets/clean-a-cat/blender/hud_icons.py
+++ b/assets/clean-a-cat/blender/hud_icons.py
@@ -225,7 +225,6 @@ def helper(mat):
     for sx in (-1, 1):
         k.box((sx * 0.3, fy, 1.6), (0.19, 0.04, 0.34), "coat_inky", bevel=False)         # the eyes
         b.box((sx * 0.3 + 0.04, fy - 0.03, 1.7), (0.07, 0.04, 0.09), "foam", bevel=False)
-        b.cyl((sx * 0.47, fy, 1.27), 0.1, 0.04, blush, segments=10, bevel=False, rot=X)   # round cheeks, as on the models (#776)
         k.box((sx * 0.21, fy, 1.24), (0.09, 0.04, 0.09), "coat_inky", bevel=False)       # the smile's corners
     k.box((0, fy, 1.15), (0.42, 0.04, 0.09), "coat_inky", bevel=False)                   # the smile
     return _fin(b, "Helper", mat, ink=k)
@@ -504,7 +503,6 @@ def helpers(mat):
     for sx in (-1, 1):
         k.box((sx * 0.3, fy, 1.52), (0.19, 0.04, 0.34), "coat_inky", bevel=False)        # the eyes
         b.box((sx * 0.3 + 0.04, fy - 0.03, 1.62), (0.07, 0.04, 0.09), "foam", bevel=False)
-        b.cyl((sx * 0.47, fy, 1.2), 0.1, 0.04, blush, segments=10, bevel=False, rot=X)    # round cheeks, as on the models (#776)
         k.box((sx * 0.21, fy, 1.17), (0.09, 0.04, 0.09), "coat_inky", bevel=False)       # the smile's corners
     k.box((0, fy, 1.08), (0.42, 0.04, 0.09), "coat_inky", bevel=False)                   # the smile
     return _fin(b, "Helpers", mat, ink=k)
@@ -539,17 +537,17 @@ def _staff_head(b, k, at, s, skin, hair, bun=False, blush="nose_bubblegum"):
     for sx in (-1, 1):
         k.box(P(sx * 0.3, fy, 1.5), Z(0.19, 0.04, 0.34), "coat_inky", bevel=False)
         b.box(P(sx * 0.3 + 0.04, fy - 0.03, 1.6), Z(0.07, 0.04, 0.09), "foam", bevel=False)
-        b.cyl(P(sx * 0.47, fy, 1.18), 0.1 * s, 0.04 * s, blush, segments=10, bevel=False, rot=X)
         k.box(P(sx * 0.21, fy, 1.15), Z(0.09, 0.04, 0.09), "coat_inky", bevel=False)
     k.box(P(0, fy, 1.06), Z(0.42, 0.04, 0.09), "coat_inky", bevel=False)
 
 
 def helpers_team(mat):
     """Helpers, option A (#1110): two helpers side by side, so the button says "your staff" and is nobody in
-    particular. One with a brown bun in front, one with a dark crop behind and to the right."""
+    particular. One with brown hair in front, one with a dark crop behind and to the right. No bun and no cheek
+    blush (#1140, the owner 2026-11-27: "remove the bun on the head of one of the helpers ... and it will look fine")."""
     b, k = Builder(), Builder()
     _staff_head(b, k, (1.0, 0.9, 0.3), 0.88, "skin_tan", "fur_charcoal")
-    _staff_head(b, k, (-0.7, 0.0, 0.0), 1.0, "skin_light", "fur_brown", bun=True)
+    _staff_head(b, k, (-0.7, 0.0, 0.0), 1.0, "skin_light", "fur_brown")   # no bun (the owner, 2026-11-27)
     return _fin(b, "HelpersTeam", mat, ink=k)
 
 
